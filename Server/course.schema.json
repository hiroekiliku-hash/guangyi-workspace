{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.kdfz.com.cn/api/integrations/v1/courses/schema",
  "title": "WORKSHOP-COURSE/1 with structured-1 rich presentations",
  "description": "A backward-compatible curriculum data contract. Native code is displayed as data; explicit HTML/SVG rich presentations run only in the isolated offline client sandbox. The server never executes curriculum source.",
  "$comment": "MaxLengths are additionally enforced in UTF-16 code units by the server and Swift client. JSON Schema counts Unicode code points. The API also enforces the 1 MiB UTF-8 document limit, global case-insensitive UUID uniqueness, code line references, table row widths and option references.",
  "x-workshop-extensionVersion": "structured-1",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "WORKSHOP-COURSE/1"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
      "x-workshop-maxUTF16Length": 240,
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
      "x-workshop-maxUTF16Length": 2000
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      },
      "minItems": 1,
      "maxItems": 40
    }
  },
  "required": [
    "protocol",
    "id",
    "title",
    "summary",
    "lessons"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "code": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+.-]{1,40}(?![\\s\\S])"
        },
        "source": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 20000,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "filename": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 240,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "highlightLines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20001
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          },
          "minItems": 0,
          "maxItems": 40
        },
        "stdin": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 4000
        },
        "expectedOutput": {
          "type": "string",
          "maxLength": 8000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 8000
        }
      },
      "required": [
        "language",
        "source"
      ],
      "additionalProperties": false,
      "$comment": "Line numbers must not exceed the number of CRLF/CR/LF-delimited source lines; annotation.line must be unique. The API performs these semantic checks."
    },
    "annotation": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20001
        },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 2000,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        }
      },
      "required": [
        "line",
        "text"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
            "x-workshop-maxUTF16Length": 120,
            "minLength": 1,
            "allOf": [
              {
                "pattern": "\\S"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
              "x-workshop-maxUTF16Length": 2000
            },
            "minItems": 1,
            "maxItems": 8
          },
          "minItems": 1,
          "maxItems": 60
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "$comment": "Every row must contain exactly as many cells as columns; the API enforces this cross-field rule."
    },
    "teachingItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 240,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$",
          "x-workshop-maxUTF16Length": 4000,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        }
      },
      "required": [
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "flashcard": {
      "type": "object",
      "properties": {
        "front": {
          "type": "string",
          "maxLength": 2000,
