          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "value": {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "code"
            },
            "code": {
              "$ref": "#/$defs/code"
            }
          },
          "required": [
