# Copy to .env on your own server. Never ship real values with the app.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
DISPLAY_NAME=广益
# Optional APNs setup; keep disabled until your Apple credentials are ready.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
APNS_ALLOWED_BUNDLE_IDS=com.guangyi.workspace.native.ios,com.guangyi.workspace.native.mac
